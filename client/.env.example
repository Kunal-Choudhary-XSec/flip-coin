# ------------------------------------------------------------------
# Stellar CoinFlip - Environment Variables
# Copy this file to .env.local and fill in the values.
# ------------------------------------------------------------------

# Deployed CoinFlip contract ID (filled automatically by scripts/deploy.sh)
NEXT_PUBLIC_COINFLIP_CONTRACT_ID=CONTRACT_ADDRESS_HERE

# Stellar network: TESTNET (default) or PUBLIC
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Soroban RPC endpoint
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Horizon endpoint (used for account balances)
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Native XLM Stellar Asset Contract (SAC) on Testnet
NEXT_PUBLIC_NATIVE_TOKEN_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Block explorer base URL
NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet
